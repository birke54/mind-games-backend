{
  "family": "mind-games-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::851725201833:role/dev-mind-games-exec",
  "taskRoleArn": "arn:aws:iam::851725201833:role/dev-mind-games-task",
  "containerDefinitions": [
    {
      "name": "mind-games-backend",
      "image": "851725201833.dkr.ecr.us-west-2.amazonaws.com/mind-games-backend:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name":  "JWT_EXPIRATION_MINUTES", "value": "15"},
        { "name": "JWT_REFRESH_EXPIRATION_DAYS", "value": "30" },
        { "name": "DB_URL", "value": "jdbc:mysql://mind-games-dev-db.c9ysoic22e9q.us-west-2.rds.amazonaws.com:3306/mind_games_dev?sslMode=VERIFY_IDENTITY&serverTimezone=UTC&characterEncoding=utf8" },
        { "name": "COOKIE_SECURE", "value": "true" },
        { "name": "SECURITY_LOCKOUT_THRESHOLD", "value": "5" },
        { "name": "BOARD_GRADING_MIN_THRESHOLD", "value": "43" },
        { "name": "BOARD_GRADING_EASY_MAX_THRESHOLD", "value": "52" },
        { "name": "BOARD_GRADING_MODERATE_MAX_THRESHOLD", "value": "72" },
        { "name": "BOARD_GRADING_HARD_MAX_THRESHOLD", "value": "92" },
        { "name": "BOARD_GENERATION_PREGENERATION_BOARD_COUNT", "value": "5" },
        { "name": "BOARD_GENERATION_LOW_WATERMARK", "value": "2" },
        { "name": "BOARD_GENERATION_MAX_ATTEMPTS_PER_BOARD", "value": "3"}
      ],
      "secrets": [
        { "name": "JWT_SECRET",  "valueFrom": "arn:aws:secretsmanager:us-west-2:851725201833:secret:dev/mind-games-dev/jwt-signing-secret-qbiiIA:JWT_SECRET::" },
        { "name": "DB_USERNAME", "valueFrom": "arn:aws:secretsmanager:us-west-2:851725201833:secret:rds!db-e4dbe456-c9b7-499f-9b0f-806a20879b31-IhuHYj:username::" },
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-west-2:851725201833:secret:rds!db-e4dbe456-c9b7-499f-9b0f-806a20879b31-IhuHYj:password::" },
        { "name": "ORIGIN_VERIFY_SECRET", "valueFrom": "arn:aws:secretsmanager:us-west-2:851725201833:secret:dev/mind-games/origin-verify-secret-vFFflG:X-Origin-Verify::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/dev/mind-games",
          "awslogs-region": "us-west-2",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
